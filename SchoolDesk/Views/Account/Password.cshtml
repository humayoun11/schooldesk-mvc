@model PasswordForm
@{ViewBag.Title="Change password";}
<div class="page-heading"><div><span class="eyebrow">ACCOUNT SECURITY</span><h1>Change password</h1><p>Updating your password signs out existing sessions and revokes API tokens.</p></div></div>
<section class="panel form-panel">@using(Html.BeginForm()){ @Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="validation"})<label>Current password</label>@Html.PasswordFor(m=>m.CurrentPassword,new{autocomplete="current-password",required="required"})<label>New password · at least 12 characters</label>@Html.PasswordFor(m=>m.NewPassword,new{autocomplete="new-password",required="required",minlength="12"})<label>Confirm new password</label>@Html.PasswordFor(m=>m.ConfirmPassword,new{autocomplete="new-password",required="required"})<button class="button">Update password</button>}</section>
