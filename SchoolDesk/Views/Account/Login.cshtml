@model LoginForm
@{ViewBag.Title="Sign in";}
<div class="login-shell"><section class="login-story"><span class="eyebrow">SCHOOL MANAGEMENT, SIMPLIFIED</span><h1>A clearer view<br/>of every school day.</h1><p>Students, attendance, learning and finance—connected in one focused workspace.</p><div class="story-grid"><div><strong>01</strong><span>Organised records</span></div><div><strong>02</strong><span>Accountable access</span></div><div><strong>03</strong><span>Meaningful reports</span></div></div></section><section class="login-card"><span class="brand-mark">S</span><h2>Welcome back</h2><p class="muted">Sign in with your school account.</p>@using(Html.BeginForm("Login","Account",FormMethod.Post)){@Html.AntiForgeryToken()@Html.HiddenFor(m=>m.ReturnUrl)@Html.ValidationSummary(false,"",new{@class="validation"})<label for="Email">Email address</label>@Html.TextBoxFor(m=>m.Email,new{type="email",autocomplete="username",required="required",maxlength="254"})<label for="Password">Password</label>@Html.PasswordFor(m=>m.Password,new{autocomplete="current-password",required="required",maxlength="128"})<button class="button full" type="submit">Sign in to workspace →</button>}<p class="small muted">Need access? Contact your school administrator.</p></section></div>
