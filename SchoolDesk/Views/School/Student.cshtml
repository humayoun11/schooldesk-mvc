@model StudentForm
@{ViewBag.Title=Model.Id==0?"New admission":"Edit student";}
<div class="page-heading"><div><span class="eyebrow">STUDENT RECORDS</span><h1>@ViewBag.Title</h1><p>Record student details and link the correct guardian accounts.</p></div><a href="@Url.Action("Students")">← Students</a></div>
<section class="panel form-panel">@using(Html.BeginForm()){ @Html.AntiForgeryToken()@Html.HiddenFor(m=>m.Id)@Html.ValidationSummary(false,"",new{@class="validation"})<div class="form-grid"><div><label>Admission number</label>@Html.TextBoxFor(m=>m.AdmissionNumber,new{required="required",maxlength="30"})</div><div><label>Full name</label>@Html.TextBoxFor(m=>m.FullName,new{required="required",maxlength="100"})</div><div><label>Date of birth</label>@Html.TextBoxFor(m=>m.BirthDate,"{0:yyyy-MM-dd}",new{type="date",required="required"})</div><div><label>Class / section</label>@Html.DropDownListFor(m=>m.ClassId,Ui.Options(ViewBag.ClassOptions,Model.ClassId),"Select class",new{required="required"})</div><div><label>Guardian name</label>@Html.TextBoxFor(m=>m.GuardianName,new{maxlength="150"})</div><div><label>Guardian phone</label>@Html.TextBoxFor(m=>m.GuardianPhone,new{maxlength="30",type="tel"})</div><div><label>Parent login account</label>@Html.DropDownListFor(m=>m.ParentUserId,Ui.Options(ViewBag.ParentOptions,Model.ParentUserId),"No linked parent")</div><div><label>Student login account</label>@Html.DropDownListFor(m=>m.UserId,Ui.Options(ViewBag.StudentUsers,Model.UserId),"No linked student")</div></div><button class="button">Save student</button>}</section>
