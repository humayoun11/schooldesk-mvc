@model ExamForm
@{ViewBag.Title="Exams";}
<div class="page-heading"><div><span class="eyebrow">LEARNING & ASSESSMENT</span><h1>Exams</h1><p>Create assessments and record results for your assigned classes.</p></div></div><section class="panel">@using(Html.BeginForm("CreateExam","School",FormMethod.Post)){@Html.AntiForgeryToken()<h2>New assessment</h2><div class="form-grid"><div><label>Title</label>@Html.TextBoxFor(m=>m.Title,new{required="required",maxlength="100"})</div><div><label>Subject</label>@Html.TextBoxFor(m=>m.Subject,new{required="required",maxlength="80"})</div><div><label>Class</label>@Html.DropDownListFor(m=>m.ClassId,Ui.Options(ViewBag.Classes),"Choose class",new{required="required"})</div><div><label>Maximum marks</label>@Html.TextBoxFor(m=>m.MaxMarks,new{type="number",min="1",max="1000",required="required"})</div><div><label>Exam date</label>@Html.TextBoxFor(m=>m.ExamDate,"{0:yyyy-MM-dd}",new{type="date",required="required"})</div></div><button class="button">Create assessment</button>}</section><section class="panel"><table><thead><tr><th>Title</th><th>Subject</th><th>Class</th><th>Max marks</th><th>Date</th><th>Results</th></tr></thead><tbody>@foreach(DataRow r in ((DataTable)ViewBag.Rows).Rows){<tr><td>@r["Title"]</td><td>@r["Subject"]</td><td>@r["Class"]</td><td>@r["MaxMarks"]</td><td>@Ui.Cell(r["ExamDate"])</td><td><a href="@Url.Action("Marks",new{id=r["Id"]})">Enter marks →</a></td></tr>}</tbody></table></section>
