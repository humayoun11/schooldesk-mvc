@model TablePage
@{ViewBag.Title=Model.Title;var action=ViewContext.RouteData.Values["action"].ToString();}
<div class="page-heading"><div><span class="eyebrow">SCHOOL WORKSPACE</span><h1>@Model.Title</h1><p>@Model.Description</p></div><div class="actions">@if(action=="Students"&&User.IsInRole("Admin")){<a class="button" href="@Url.Action("Student")">+ Add student</a>}@if(action=="Fees"&&(User.IsInRole("Admin")||User.IsInRole("Accountant"))){<a class="button" href="@Url.Action("Invoice")">+ Create invoice</a>}<button class="button secondary" type="button" data-print>Print report</button></div></div>
<section class="panel">@using(Html.BeginForm(action,"School",FormMethod.Get,new{@class="toolbar"})){<label class="sr-only" for="q">Search records</label><input name="q" id="q" value="@Model.Search" placeholder="Search records…" maxlength="100"/><button class="button secondary">Search</button>}<div class="table-wrap"><table><thead><tr>@foreach(DataColumn c in Model.Rows.Columns){if(c.ColumnName!="Id"){<th>@c.ColumnName</th>}}@if(action=="Students"&&User.IsInRole("Admin")||action=="Fees"){<th>Actions</th>}</tr></thead><tbody>@foreach(DataRow r in Model.Rows.Rows){<tr>@foreach(DataColumn c in Model.Rows.Columns){if(c.ColumnName!="Id"){<td>@Ui.Cell(r[c])</td>}}@if(action=="Students"&&User.IsInRole("Admin")){<td class="row-actions"><a href="@Url.Action("Student",new{id=r["Id"]})">Edit</a>@using(Html.BeginForm("ArchiveStudent","School",FormMethod.Post,new{data_confirm="Archive this student? Historic records will remain."})){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r["Id"]"/><button class="text-button danger">Archive</button>}</td>}@if(action=="Fees"){<td><a href="@Url.Action("Receipt",new{id=r["Id"]})">View invoice →</a></td>}</tr>}@if(Model.Rows.Rows.Count==0){<tr><td colspan="12" class="empty"><strong>No records found</strong><br/>Try a different search or add your first record.</td></tr>}</tbody></table></div><div class="pagination"><span>Page @Model.Page · up to 20 records per page</span><div>@if(Model.Page>1){<a href="@Url.Action(action,new{page=Model.Page-1,q=Model.Search})">← Previous</a>}@if(Model.HasNext){<a href="@Url.Action(action,new{page=Model.Page+1,q=Model.Search})">Next →</a>}</div></div></section>
