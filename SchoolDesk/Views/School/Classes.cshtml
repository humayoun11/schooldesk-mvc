@model ClassForm
@{ViewBag.Title="Classes & teachers";}
<div class="page-heading"><div><span class="eyebrow">ACADEMIC ORGANISATION</span><h1>Classes & teachers</h1><p>Class sections and their assigned teachers.</p></div></div>
@if(User.IsInRole("Admin")){<section class="panel">@using(Html.BeginForm("CreateClass","School",FormMethod.Post)){@Html.AntiForgeryToken()<h2>Add a class</h2><div class="form-grid"><div><label>Class name</label>@Html.TextBoxFor(m=>m.Name,new{required="required",maxlength="80",placeholder="Grade 7"})</div><div><label>Section</label>@Html.TextBoxFor(m=>m.Section,new{required="required",maxlength="20",placeholder="A"})</div><div><label>Assigned teacher</label>@Html.DropDownListFor(m=>m.TeacherId,Ui.Options(ViewBag.Teachers),"Choose teacher",new{required="required"})</div></div><button class="button">Create class</button>}</section>}
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Class</th><th>Section</th><th>Teacher</th><th>Students</th>@if(User.IsInRole("Admin")){<th>Assign teacher</th>}</tr></thead><tbody>@foreach(DataRow r in ((DataTable)ViewBag.Rows).Rows){<tr><td>@r["Name"]</td><td>@r["Section"]</td><td>@r["Teacher"]</td><td>@r["Students"]</td>@if(User.IsInRole("Admin")){<td>@using(Html.BeginForm("AssignTeacher","School",FormMethod.Post,new{@class="inline-form"})){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r["Id"]"/>@Html.DropDownList("teacherId",Ui.Options(ViewBag.Teachers),"Choose teacher",new{required="required"})<button class="button secondary">Assign</button>}</td>}</tr>}</tbody></table></div></section>
