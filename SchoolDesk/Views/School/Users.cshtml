@model UserForm
@{ViewBag.Title="User access";}
<div class="page-heading"><div><span class="eyebrow">ROLE-BASED ACCESS</span><h1>User access</h1><p>Create accounts and manage active access. Students and parents are linked from student records.</p></div></div>
<section class="panel">@using(Html.BeginForm("CreateUser","School",FormMethod.Post)){@Html.AntiForgeryToken()<h2>Create account</h2><div class="form-grid"><div><label>Full name</label>@Html.TextBoxFor(m=>m.FullName,new{required="required",maxlength="100"})</div><div><label>Email</label>@Html.TextBoxFor(m=>m.Email,new{type="email",required="required",maxlength="254"})</div><div><label>Initial password · 12+ characters</label>@Html.PasswordFor(m=>m.Password,new{required="required",minlength="12",maxlength="128",autocomplete="new-password"})</div><div><label>Role</label><select name="Role"><option>Teacher</option><option>Accountant</option><option>Parent</option><option>Student</option><option>Admin</option></select></div></div><button class="button">Create account</button>}</section>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Access</th></tr></thead><tbody>@foreach(DataRow r in ((DataTable)ViewBag.Rows).Rows){<tr><td>@r["FullName"]</td><td>@r["Email"]</td><td><span class="pill">@r["Role"]</span></td><td>@Ui.Cell(r["IsActive"])</td><td>@if((int)r["Id"]!=Auth.Id){using(Html.BeginForm("SetUserActive","School",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r["Id"]"/><input type="hidden" name="active" value="@(!(bool)r["IsActive"] ? "true" : "false")"/><button class="text-button">@((bool)r["IsActive"]?"Disable":"Enable")</button>}}</td></tr>}</tbody></table></div></section>
