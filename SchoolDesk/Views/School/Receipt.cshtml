@model PaymentForm
@{ViewBag.Title="Fee invoice";DataRow r=ViewBag.Invoice;}
<div class="page-heading"><div><span class="eyebrow">FEE INVOICE</span><h1>Invoice #@(((int)r["Id"]).ToString("D6"))</h1><p>@r["FullName"] · @r["AdmissionNumber"]</p></div><button class="button secondary" type="button" data-print>Print invoice</button></div><section class="panel invoice"><div class="panel-heading"><h2>@System.Configuration.ConfigurationManager.AppSettings["SchoolName"]</h2><span class="pill">@((decimal)r["Balance"]==0?"Paid":"Outstanding")</span></div><p>@r["Description"]</p><p class="muted">Due @Ui.Cell(r["DueDate"])</p><div class="metric-grid"><div class="metric"><span>Total</span><strong>@Ui.Cell(r["Amount"])</strong><small>PKR</small></div><div class="metric"><span>Paid</span><strong>@Ui.Cell(r["Paid"])</strong><small>PKR</small></div><div class="metric"><span>Balance</span><strong>@Ui.Cell(r["Balance"])</strong><small>PKR</small></div></div><h3>Payment history</h3><table><thead><tr><th>Reference</th><th>Amount (PKR)</th><th>Date</th></tr></thead><tbody>@foreach(DataRow p in ((DataTable)ViewBag.Payments).Rows){<tr><td>@p["Reference"]</td><td>@Ui.Cell(p["Amount"])</td><td>@Ui.Cell(p["PaidAt"])</td></tr>}</tbody></table></section>
@if((User.IsInRole("Admin")||User.IsInRole("Accountant"))&&(decimal)r["Balance"]>0){<section class="panel no-print">@using(Html.BeginForm("Pay","School",FormMethod.Post)){@Html.AntiForgeryToken()@Html.HiddenFor(m=>m.InvoiceId)<h2>Record payment</h2><div class="form-grid"><div><label>Amount (PKR)</label>@Html.TextBoxFor(m=>m.Amount,new{type="number",min="0.01",step="0.01",required="required"})</div><div><label>Unique receipt / transaction reference</label>@Html.TextBoxFor(m=>m.Reference,new{required="required",maxlength="80"})</div></div><button class="button">Record payment</button>}</section>}
