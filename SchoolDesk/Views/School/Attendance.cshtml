@{ViewBag.Title="Take attendance";}
<div class="page-heading"><div><span class="eyebrow">EVERY DAY COUNTS</span><h1>Take attendance</h1><p>Select your class and date, then record each student's attendance.</p></div></div>
<section class="panel">@using(Html.BeginForm("Attendance","School",FormMethod.Get,new{@class="toolbar"})){@Html.DropDownList("classId",Ui.Options(ViewBag.Classes,ViewBag.ClassId),"Select class",new{required="required"})<input type="date" name="day" value="@(((DateTime)ViewBag.Day).ToString("yyyy-MM-dd"))" max="@DateTime.Today.ToString("yyyy-MM-dd")"/><button class="button">Load class</button>}
@if(ViewBag.ClassId!=null){using(Html.BeginForm("SaveAttendance","School",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="classId" value="@ViewBag.ClassId"/><input type="hidden" name="day" value="@(((DateTime)ViewBag.Day).ToString("yyyy-MM-dd"))"/><div class="table-wrap"><table><thead><tr><th>Student</th><th>Admission number</th><th>Attendance</th></tr></thead><tbody>@foreach(DataRow r in ((DataTable)ViewBag.Rows).Rows){<tr><td>@r["FullName"]<input type="hidden" name="studentIds" value="@r["Id"]"/></td><td>@r["AdmissionNumber"]</td><td><select name="statuses">@foreach(var status in new[]{"Present","Absent","Late","Excused"}){if(status==r["Status"].ToString()){<option selected="selected">@status</option>}else{<option>@status</option>}}</select></td></tr>}</tbody></table></div>@if(((DataTable)ViewBag.Rows).Rows.Count>0){<button class="button">Save attendance</button>}else{<p class="empty">No active students in this class.</p>}}}</section>
