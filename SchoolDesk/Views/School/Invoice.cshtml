@model InvoiceForm
@{ViewBag.Title="Create invoice";}
<div class="page-heading"><div><span class="eyebrow">SCHOOL FINANCE</span><h1>Create fee invoice</h1><p>All amounts are in PKR.</p></div><a href="@Url.Action("Fees")">← Fees</a></div><section class="panel form-panel">@using(Html.BeginForm()){@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="validation"})<label>Student</label>@Html.DropDownListFor(m=>m.StudentId,Ui.Options(ViewBag.Students,Model.StudentId),"Choose student",new{required="required"})<label>Description</label>@Html.TextBoxFor(m=>m.Description,new{required="required",maxlength="150",placeholder="Monthly tuition · October"})<div class="form-grid"><div><label>Amount (PKR)</label>@Html.TextBoxFor(m=>m.Amount,new{type="number",min="0.01",max="10000000",step="0.01",required="required"})</div><div><label>Due date</label>@Html.TextBoxFor(m=>m.DueDate,"{0:yyyy-MM-dd}",new{type="date",required="required"})</div></div><button class="button">Create invoice</button>}</section>
