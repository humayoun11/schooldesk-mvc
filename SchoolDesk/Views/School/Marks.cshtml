@{ViewBag.Title="Record marks";DataRow e=ViewBag.Exam;}
<div class="page-heading"><div><span class="eyebrow">ASSESSMENT RESULTS</span><h1>@e["Title"]</h1><p>@e["Subject"] · Maximum marks: @e["MaxMarks"]</p></div><a href="@Url.Action("Exams")">← Exams</a></div><section class="panel">@using(Html.BeginForm("SaveMarks","School",FormMethod.Post)){@Html.AntiForgeryToken()<input type="hidden" name="examId" value="@e["Id"]"/><table><thead><tr><th>Student</th><th>Marks</th></tr></thead><tbody>@foreach(DataRow r in ((DataTable)ViewBag.Rows).Rows){<tr><td>@r["FullName"]<input type="hidden" name="studentIds" value="@r["Id"]"/></td><td><input type="number" name="marks" min="0" max="@e["MaxMarks"]" step="0.01" value="@(r["Marks"]==DBNull.Value?"":Convert.ToDecimal(r["Marks"]).ToString(System.Globalization.CultureInfo.InvariantCulture))" required="required"/></td></tr>}</tbody></table>@if(((DataTable)ViewBag.Rows).Rows.Count>0){<button class="button">Save results</button>}}</section>
