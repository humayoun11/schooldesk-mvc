@{ViewBag.Title="Overview";}
<div class="page-heading"><div><span class="eyebrow">YOUR SCHOOL AT A GLANCE</span><h1>Good things start with clarity.</h1><p>Here is a snapshot of the records available to your account.</p></div><span class="date-chip">@DateTime.Today.ToString("dddd, dd MMM yyyy")</span></div>
<div class="metric-grid"><article class="metric"><span>Active students</span><strong>@ViewBag.Students</strong><small>Within your access</small></article><article class="metric"><span>Classes represented</span><strong>@ViewBag.Classes</strong><small>Active student enrolments</small></article><article class="metric"><span>Present today</span><strong>@ViewBag.Attendance</strong><small>Recorded attendance</small></article>@if(!User.IsInRole("Teacher")){<article class="metric accent"><span>Outstanding fees</span><strong>@String.Format("{0:N0}",ViewBag.Balance)</strong><small>PKR · unpaid invoice balances</small></article>}</div>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Recent admissions</h2><p>Active students in your workspace</p></div><a href="@Url.Action("Students","School")">View students →</a></div><div class="table-wrap"><table><thead><tr><th>Student</th><th>Class</th><th>Admission no.</th></tr></thead><tbody>@foreach(DataRow r in ((DataTable)ViewBag.Recent).Rows){<tr><td><strong>@r["FullName"]</strong></td><td>@r["Class"]</td><td>@r["AdmissionNumber"]</td></tr>}@if(((DataTable)ViewBag.Recent).Rows.Count==0){<tr><td colspan="3" class="empty">No students available yet.</td></tr>}</tbody></table></div></section><section class="panel welcome-panel"><span class="eyebrow">BUILT FOR YOUR ROLE</span><h2>The right information.<br/>The right access.</h2><p>Your workspace shows records relevant to your account. Keep attendance current and review reports regularly.</p><a class="button secondary" href="@Url.Action("AttendanceHistory","School")">Review attendance →</a></section></div>
