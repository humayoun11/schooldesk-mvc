{
  "openapi": "3.0.3",
  "info": {
    "title": "SchoolDesk API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5080",
      "description": "Local Windows development"
    }
  ],
  "paths": {
    "/api/token": {
      "post": {
        "summary": "Issue a 15-minute token",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "Email",
                  "Password"
                ],
                "properties": {
                  "Email": {
                    "type": "string",
                    "format": "email"
                  },
                  "Password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT access token"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication failed"
          }
        }
      }
    },
    "/api/students": {
      "get": {
        "summary": "List students within the caller role and record scope",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated student data"
          },
          "401": {
            "description": "Missing, expired, invalid or revoked token"
          }
        }
      }
    },
    "/Api/Revoke": {
      "post": {
        "summary": "Revoke all existing tokens and sessions for this user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Tokens and sessions revoked"
          },
          "401": {
            "description": "Invalid token"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
